module Multiplexer_4x1(
    input wire [3:0] I,
    input wire [1:0] S,
    output reg  Y
    );
 always@(*)begin
   case(S)
   2'b00 : Y = I[0]; //I0 selected
   2'b01 : Y = I[1]; //I1 selected
   2'b10 : Y = I[2]; //I2 selected
   2'b11 : Y = I[3]; //I3 selected
   default : Y = 1'b0;
   endcase
  end
endmodule
